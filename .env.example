# 로컬 DB (compose.yaml)
POSTGRES_DB=company_insight
POSTGRES_USER=company_insight
POSTGRES_PASSWORD=

# 애플리케이션
DB_URL=jdbc:postgresql://localhost:5432/company_insight
DB_USERNAME=company_insight
DB_PASSWORD=

# API 문서(Swagger UI). 로컬에서 볼 때만 true로 바꾼다. 운영 서버는 false
API_DOCS_ENABLED=false

# 외부 API
DART_API_KEY=
GEMINI_API_KEY=

# 앱이 뜬 직후 재무를 받을 회사의 종목코드(쉼표로 구분). 비워 두면 받지 않는다. 예: 005930,000660
# 기업 목록이 먼저 있어야 한다. 새 DB라면 앱을 한 번 띄워 기업 목록을 받은 뒤 다시 띄운다
FINANCIAL_COLLECT_ON_STARTUP=
# true면 앱이 뜬 직후 저장된 재무 원본에서 재무 행을 다시 뽑는다(DART를 부르지 않는다). 뽑는 규칙을 고친 뒤 한 번 켠다
FINANCIAL_REEXTRACT_ON_STARTUP=false
