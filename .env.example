# 로컬 DB (compose.yaml)
POSTGRES_DB=company_insight
POSTGRES_USER=company_insight
POSTGRES_PASSWORD=

# 애플리케이션
DB_URL=jdbc:postgresql://localhost:5432/company_insight
DB_USERNAME=company_insight
DB_PASSWORD=

# API 문서(Swagger UI). 로컬에서만 true, 운영 서버에는 넣지 않는다
API_DOCS_ENABLED=true

# 외부 API
DART_API_KEY=
GEMINI_API_KEY=
